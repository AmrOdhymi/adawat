<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every conversion and tool, with no window code, so the app and the command line share it. -->
  <PropertyGroup>
    <RootNamespace>Adawat.Core</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\shared\strings.ar.json" LogicalName="strings.ar.json" />
    <EmbeddedResource Include="..\..\shared\patterns.ar.json" LogicalName="patterns.ar.json" />
  </ItemGroup>
</Project>
